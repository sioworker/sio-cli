#compdef sio

local -a hosts=(${(f)"$(sio hosts 2>/dev/null | cut -c3- | cut -d' ' -f1)"})
if ((CURRENT == 2)); then
	local -a cmds=(
		'add-host:add a host'
		'rm-host:remove a host'
		'hosts:list hosts'
		'main:set main host'
		'token:set host token'
		'ping:check auth'
		'upload:submit a solution'
	)
	_describe cmd cmds
	return
fi
case $words[2] in
add-host) ((CURRENT == 3)) && _values opt '--main[make it the main host]' ;;
rm-host|main|token|ping) ((CURRENT == 3)) && _describe host hosts ;;
upload|up) ((CURRENT >= 4)) && _files ;;
esac
